#!/bin/bash
# AquaTransport postinstall.
#
# Runs after the payload -- /usr/share/aquatransport/{aquatransport.dylib, aqwatch, aqinject,
# rule files} -- is on disk. It installs the aqwatch LaunchDaemon, which holds each process at
# its first network use until the library is loaded into it. Nothing is written to launchd's
# global environment, so a faulty library is confined to the process it is loaded into and can
# never keep the machine from starting.
#
# Everything is in one directory. The dylib and the rule files have to be under /usr/share
# because a target dlopens the dylib and reads the rules itself, under its own sandbox, and
# /usr/share is one of the few paths system.sb lets a sandboxed process read. The tools cost
# nothing by joining them: the directory is root:wheel 0755, so it is not user-writable, and
# aqinject requires task_for_pid, which a non-root caller fails wherever the binary sits.
#
# $3 is the target volume, which is not always "/".

set -e
TARGET="${3:-/}"
LIBDIR="$TARGET/usr/share/aquatransport"
DYLIB="$LIBDIR/aquatransport.dylib"
PLIST_LABEL="org.aquatransport.watch"
PLIST="$TARGET/Library/LaunchDaemons/$PLIST_LABEL.plist"

say() { echo "AquaTransport: $*"; }

# ---- 1. sanity-check the payload ------------------------------------------------------
# A slice can only inject targets of its own architecture, so a build missing one would leave
# those unpatched. That is a packaging error, so refuse it.
[ -f "$DYLIB" ]           || { say "FATAL: $DYLIB missing"; exit 1; }
[ -x "$LIBDIR/aqwatch" ]  || { say "FATAL: $LIBDIR/aqwatch missing"; exit 1; }
[ -x "$LIBDIR/aqinject" ] || { say "FATAL: $LIBDIR/aqinject missing"; exit 1; }

if [ -x /usr/bin/lipo ]; then ARCHS=$(/usr/bin/lipo -info "$DYLIB" 2>/dev/null | sed 's/.*://')
else ARCHS=$(/usr/bin/file "$DYLIB" 2>/dev/null); fi
for a in x86_64 i386; do
  case "$ARCHS" in
    *"$a"*) ;;
    *) say "FATAL: $DYLIB has no $a slice (found:$ARCHS); $a processes could not be patched."
       exit 1 ;;
  esac
done

# ---- 2. ownership and permissions ----------------------------------------------------
# The dylib is loaded into root daemons, so a user-writable path would be a privilege
# escalation. Enforce regardless of how the payload was built.
#
# 0644 on the files and 0755 on the directory are also what a sandboxed target needs:
# system.sb's read grant carries a (file-mode #o0004) requirement, and the target has to
# traverse the directory to reach the dylib.
chown -R root:wheel "$LIBDIR"
chmod 0755 "$LIBDIR"
find "$LIBDIR" -type f -exec chmod 0644 {} +
chmod 0755 "$LIBDIR/aqwatch" "$LIBDIR/aqinject"

# The daemon's own runtime files are not world-readable: they list pids, and nothing sandboxed
# reads them. They are recreated as needed, so removing a stale pair is always safe.
rm -f "$LIBDIR/held.journal" "$LIBDIR/armed.stamp"

# ---- 3. seed config files without overwriting existing ones --------------------------
for f in redirects.txt headers.txt flags.txt; do
  if [ ! -f "$LIBDIR/$f" ] && [ -f "$LIBDIR/examples/$f" ]; then
    cp "$LIBDIR/examples/$f" "$LIBDIR/$f"
    chown root:wheel "$LIBDIR/$f"; chmod 0644 "$LIBDIR/$f"
    say "installed default $f"
  else
    say "kept existing $f"
  fi
done

# ---- 4. install the daemon -----------------------------------------------------------
# Everything is co-located, so aqwatch derives every path from its own location and this
# carries a single argument. KeepAlive is also what drives recovery: a daemon that dies while
# holding a process is restarted, and releases what it left behind on the way up.
mkdir -p "$TARGET/Library/LaunchDaemons"
cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$PLIST_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/share/aquatransport/aqwatch</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
PLIST_EOF
chown root:wheel "$PLIST"; chmod 0644 "$PLIST"

# ---- 5. start now if installing onto the running system -------------------------------
# On a target volume that is not the running system, only the plist is placed; it starts on
# that volume's next boot.
if [ "$TARGET" = "/" ]; then
  launchctl unload "$PLIST" 2>/dev/null || true
  launchctl load "$PLIST" 2>/dev/null || true
  say "the connection gate is running."
else
  say "installed on $TARGET; the gate starts on that volume's next boot."
fi

say "installed. No restart required."
say "Processes already running are covered at their next connection; a process holding a"
say "long-lived one may not reach a gate for a while. Restarting it, or rebooting, covers it."
say "Flags (one per line) go in $LIBDIR/flags.txt:  debug, disabled-mtls, gate-off"
say "Log: /var/log/aquatransport.log"
say "To uninstall:  sudo $LIBDIR/uninstall.sh"
exit 0
