#!/bin/bash
# AquaTransport postinstall.
#
# Runs after the payload is on disk:
#
#   /usr/share/aquatransport/   the dylib and the rule files -- everything a patched process
#                               reads for itself, in one of the few directories a sandboxed
#                               process may read.
#   /Library/AquaTransport/     insert_dylib and aquatransport.sh, which root runs. Nothing
#                               sandboxed ever reads these, so the /usr/share requirement that
#                               governs the dylib does not apply to them.
#
# The payload alone changes nothing: the library is loaded because Security.framework carries a
# load command naming it, and adding that command is what happens here. aquatransport.sh does
# the work, so a package install and a command-line install take the same path through the same
# checks -- including the rollback that restores Security if a freshly started process does not
# load the library.
#
# $3 is the target volume, which is not always "/".

set -e
TARGET="${3:-/}"
DEST="$TARGET/Library/AquaTransport"
LIBDIR="$TARGET/usr/share/aquatransport"
DYLIB="$LIBDIR/aquatransport.dylib"

say() { echo "AquaTransport: $*"; }

# ---- 1. sanity-check the payload ------------------------------------------------------
[ -f "$DYLIB" ]                 || { say "FATAL: $DYLIB missing"; exit 1; }
[ -x "$DEST/aquatransport.sh" ] || { say "FATAL: $DEST/aquatransport.sh missing"; exit 1; }
[ -x "$DEST/insert_dylib" ]     || { say "FATAL: $DEST/insert_dylib missing"; exit 1; }

# A slice missing here would leave processes of that architecture loading Security from disk for
# nothing: the weak load command resolves to a library with no slice for them, and is skipped.
if [ -x /usr/bin/lipo ]; then ARCHS=$(/usr/bin/lipo -info "$DYLIB" 2>/dev/null | sed 's/.*://')
else ARCHS=$(/usr/bin/file "$DYLIB" 2>/dev/null); fi
for a in x86_64 i386; do
  case "$ARCHS" in
    *"$a"*) ;;
    *) say "FATAL: $DYLIB has no $a slice (found:$ARCHS); $a processes would go unpatched."
       exit 1 ;;
  esac
done

# ---- 2. ownership and permissions ----------------------------------------------------
# The library is loaded into root daemons, so a user-writable path would be a privilege
# escalation. Enforce regardless of how the payload was built.
#
# 0644 on the files under $LIBDIR and 0755 on $LIBDIR itself are also what a sandboxed process
# needs: system.sb's read grant carries a (file-mode #o0004) requirement, and the process has to
# traverse the directory to reach the dylib.
chown -R root:wheel "$DEST" "$LIBDIR"
chmod 0755 "$DEST" "$LIBDIR"
find "$DEST" "$LIBDIR" -type f -exec chmod 0644 {} +
chmod 0755 "$DEST/aquatransport.sh" "$DEST/insert_dylib"
[ -f "$DEST/uninstall.sh" ] && chmod 0755 "$DEST/uninstall.sh"

# ---- 3. seed config files without overwriting existing ones --------------------------
for f in redirects.txt headers.txt flags.txt; do
  if [ ! -f "$LIBDIR/$f" ] && [ -f "$LIBDIR/examples/$f" ]; then
    cp "$LIBDIR/examples/$f" "$LIBDIR/$f"
    chown root:wheel "$LIBDIR/$f"; chmod 0644 "$LIBDIR/$f"
    say "installed default $f"
  else
    say "kept existing $f"
  fi
done

# ---- 4. add the load command to Security.framework ------------------------------------
# Only on the running system. The patch is verified by asking a freshly started process what it
# loaded, which can only be asked of the system doing the asking; on another volume there is
# nothing to run and nothing to verify against, so that volume is patched from its own system.
if [ "$TARGET" = "/" ]; then
  AQ_INSERT_DYLIB="$DEST/insert_dylib" "$DEST/aquatransport.sh" patch
  say "Security.framework patched."
  say "Processes already running keep the Security they mapped at launch; reboot for full coverage."
else
  say "payload installed on $TARGET; nothing is patched until you run"
  say "  sudo /Library/AquaTransport/aquatransport.sh patch"
  say "from that system."
fi

say "Optional flags (one per line) go in $LIBDIR/flags.txt:  debug, disabled-mtls"
say "To uninstall:  sudo $DEST/uninstall.sh"
exit 0
