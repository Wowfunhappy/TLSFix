#!/bin/bash
# AquaTransport postinstall.
#
# The payload places the library and the rule files under /usr/share/aquatransport, and
# insert_dylib and the installer under /Library/AquaTransport. None of that loads anything: the
# library is loaded because Security.framework carries a load command naming it, and adding
# that command is what happens here. The installer does the work, so a package install and a
# command-line install are the same operation.
#
# $3 is the target volume, which is not always "/". Another volume is left to its own system:
# the framework that has to be patched is the one dyld will read at boot.

set -e
TARGET="${3:-/}"
DEST="$TARGET/Library/AquaTransport"

if [ "$TARGET" = "/" ]; then
  AQ_INSERT_DYLIB="$DEST/insert_dylib" "$DEST/aquatransport.sh" install
else
  echo "AquaTransport: files installed on $TARGET, but nothing is patched until you run"
  echo "  sudo /Library/AquaTransport/aquatransport.sh install"
  echo "from that system."
fi

echo "AquaTransport: optional flags (one per line) go in /usr/share/aquatransport/flags.txt:"
echo "  debug, disabled-mtls, allow-legacy-tls, disable-certificate-pinning"
echo "AquaTransport: to stay out of a process entirely, add its executable name to"
echo "  /usr/share/aquatransport/disabled-processes.txt"
echo "AquaTransport: to uninstall, run  sudo $DEST/uninstall.sh"
exit 0
